<Project>

	<!-- Package metadata shared by the three library projects, which import this file and add their own title, description, tags and README -->
	<PropertyGroup>
		<Authors>Michael Crino</Authors>
		<Company>Bitvantage</Company>
		<Copyright>Copyright © 2024-2026 Michael Crino</Copyright>
		<PackageProjectUrl>https://github.com/Bitvantage/InternetProtocol.NetworkPrefixLookup</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Bitvantage/InternetProtocol.NetworkPrefixLookup.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>https://github.com/Bitvantage/InternetProtocol.NetworkPrefixLookup/blob/main/CHANGELOG.md</PackageReleaseNotes>
		<VersionPrefix>3.0.0</VersionPrefix>
		<FileVersion>$(VersionPrefix)</FileVersion>
		<AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
	</PropertyGroup>

	<!-- Source Link, which the SDK includes, and a symbol package, so that a debugger can step into the published source -->
	<PropertyGroup>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!-- Package validation compares each pack's public API with the published 3.0.0 and fails on a breaking change. It
	     starts with the first version after 3.0.0, which is not published yet; a new major version moves the baseline. -->
	<PropertyGroup>
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion Condition="'$(VersionPrefix)' != '3.0.0'">3.0.0</PackageValidationBaselineVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
