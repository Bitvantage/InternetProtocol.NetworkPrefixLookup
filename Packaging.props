<Project>

	<!-- Package metadata shared by the three library projects, which import this file and add their own description, tags and README -->
	<PropertyGroup>
		<Authors>Michael Crino</Authors>
		<Company>Bitvantage</Company>
		<Version>3.1.0</Version>
		<Copyright>Copyright © 2024-2026 Michael Crino</Copyright>
		<PackageProjectUrl>https://github.com/Bitvantage/InternetProtocol.NetworkPrefixLookup</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Bitvantage/InternetProtocol.NetworkPrefixLookup.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!-- the GitHub page of the version's release tag, v$(Version), so that the link never goes stale -->
		<PackageReleaseNotes>https://github.com/Bitvantage/InternetProtocol.NetworkPrefixLookup/releases/tag/v$(Version)</PackageReleaseNotes>
	</PropertyGroup>

	<!-- Source Link, which the SDK includes, and a symbol package, so that a debugger can step into the published source -->
	<PropertyGroup>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<!-- makes CI builds reproducible by leaving local paths out of the binaries; local builds keep them for debugging -->
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!-- Package validation, so that a pack fails if the public API changes in a way that breaks consumers -->
	<PropertyGroup>
		<EnablePackageValidation>true</EnablePackageValidation>
		<!-- Compares the public API with the first version of the current major version, 3.0.0, which all three packages
		     published, so that a minor or patch release cannot break consumers of 3.0.0. -->
		<PackageValidationBaselineVersion>3.0.0</PackageValidationBaselineVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
