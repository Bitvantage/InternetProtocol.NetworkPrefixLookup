<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="../Packaging.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<RootNamespace>Bitvantage.InternetProtocol.NetworkPrefixLookup</RootNamespace>
		<Title>Bitvantage.InternetProtocol.NetworkPrefixLookup.MaxMind</Title>
		<PackageTags>maxmind;mmdb;geoip;geoip2;geolite2;asn;geolocation;ip-lookup;longest-prefix-match</PackageTags>
		<Description>Loads a whole MaxMind DB file, such as GeoIP2, GeoLite2 or ASN, into a lookup table for fast longest-prefix-match lookups by address.</Description>
	</PropertyGroup>

	<!-- Trimming and native AOT: the analyzers check that the library needs no reflection or runtime code generation -->
	<PropertyGroup>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Bitvantage.InternetProtocol.NetworkPrefixLookup\Bitvantage.InternetProtocol.NetworkPrefixLookup.csproj" />
		<PackageReference Include="MaxMind.Db" Version="5.2.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
