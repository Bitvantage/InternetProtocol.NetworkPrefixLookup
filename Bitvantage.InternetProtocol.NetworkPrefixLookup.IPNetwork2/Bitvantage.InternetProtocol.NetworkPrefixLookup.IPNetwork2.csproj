<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="../Packaging.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<RootNamespace>Bitvantage.InternetProtocol.NetworkPrefixLookup</RootNamespace>
		<Title>Bitvantage.InternetProtocol.NetworkPrefixLookup.IPNetwork2</Title>
		<PackageTags>ipnetwork2;ip;ipv4;ipv6;cidr;subnet;longest-prefix-match;lpm;ip-lookup</PackageTags>
		<Description>Longest-prefix-match lookups over IPNetwork2 networks from the IPNetwork2 package.</Description>
	</PropertyGroup>

	<!-- Trimming and native AOT: the analyzers check that the library needs no reflection or runtime code generation -->
	<PropertyGroup>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Bitvantage.InternetProtocol.NetworkPrefixLookup\Bitvantage.InternetProtocol.NetworkPrefixLookup.csproj" />
		<PackageReference Include="IPNetwork2" Version="4.3.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
